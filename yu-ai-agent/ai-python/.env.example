# 环境配置
# 复制此文件为 .env 并填入实际配置

# 应用配置
APP_NAME=yu-ai-agent-python
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# 服务器配置
HOST=0.0.0.0
PORT=8123
API_PREFIX=/api

# PostgreSQL数据库配置
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sdagent

# Elasticsearch配置
ELASTICSEARCH_HOST=192.168.152.129
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=PaiSmart2025
ELASTICSEARCH_SSL_VERIFY=false

# Redis配置
REDIS_URL=redis://8.137.79.174:6379/1
REDIS_PASSWORD=redis123

# RabbitMQ配置
RABBITMQ_URL=amqp://zsr:123456@127.0.0.1:5672/

# DashScope配置
DASHSCOPE_API_KEY=sk-da831ca6d01e4b8aaa04c1705d35f990
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# Ollama配置
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=deepseek-r1:1.5b

# 文件上传配置
UPLOAD_CHUNK_SIZE=20971520
UPLOAD_TEMP_DIR=E:/编程学习/项目/yv-ai/upload/temp
UPLOAD_FINAL_DIR=E:/编程学习/项目/yv-ai/upload/files

# 文档解析配置
PARSING_CHUNK_SIZE=500
PARSING_OVERLAP_SIZE=100
PARSING_SPLIT_STRATEGY=semantic

# 安全配置
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=E:/编程学习/项目/yv-ai/logs/python-app.log
